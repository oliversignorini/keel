{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "api": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "apps/api/Dockerfile"
      },
      "deploy": {
        "startCommand": "gunicorn config.wsgi:application --bind 0.0.0.0:$PORT",
        "healthcheckPath": "/healthz/",
        "healthcheckTimeout": 30,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 5,
        "preDeployCommand": ["python manage.py migrate --no-input"]
      }
    },
    "stream": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "apps/api/Dockerfile"
      },
      "deploy": {
        "startCommand": "uvicorn config.asgi_stream:application --host 0.0.0.0 --port $PORT",
        "healthcheckPath": "/healthz/",
        "healthcheckTimeout": 30,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 5
      }
    },
    "worker": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "apps/api/Dockerfile"
      },
      "deploy": {
        "startCommand": "celery -A config worker -l info -Q default,email,external,scheduled",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 5
      }
    },
    "beat": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "apps/api/Dockerfile"
      },
      "deploy": {
        "startCommand": "celery -A config beat -l info",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 5
      }
    }
  }
}

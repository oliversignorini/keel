# Copy to .env and fill in. No secrets or real values are committed here.
# Every variable below is read somewhere in apps/api/config/settings/.

# --- Django core ------------------------------------------------------------
# apps/api/config/settings/base.py
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ----------------------------------------------------------------
# apps/api/config/settings/base.py — parsed by django-environ's env.db().
# Port 5433, not 5432: see infra/compose.dev.yml for why.
DATABASE_URL=postgres://keel:keel@localhost:5433/keel

# --- Redis (cache + Celery broker) -------------------------------------------
# apps/api/config/settings/base.py — parsed by django-environ's env.cache().
REDIS_URL=redis://localhost:6379/0
# Celery broker/result backend. Defaults to REDIS_URL if unset.
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Cookies, CORS, CSRF (apps/api/config/settings/base.py) ------------------
# KEEL_APP_DOMAIN: the registrable domain the frontend is served from, e.g.
# "acme.com" in production. Left at "localhost" for local dev, which keeps
# SESSION_COOKIE_DOMAIN unset (host-only cookie).
KEEL_APP_DOMAIN=localhost
# Only needed once KEEL_APP_DOMAIN is a real domain — must be
# '.' + the registrable domain shared by the app and API (e.g. '.acme.com').
# apps/api/keel/core/checks.py fails `manage.py check` loudly if this is
# set but is not a parent of KEEL_APP_DOMAIN.
# DJANGO_SESSION_COOKIE_DOMAIN=.acme.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
# comma-separated origins Next.js is served from.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- allauth headless (apps/api/config/settings/base.py) ---------------------
# Next.js origin that HEADLESS_FRONTEND_URLS points verification/reset links at.
KEEL_FRONTEND_URL=http://localhost:3000
# TOTP MFA is installed only when this is true (see keel/core INSTALLED_APPS
# comment) — scaffolded and off by default per PRD §8 Phase 2.
KEEL_MFA_ENABLED=false
# Google is the one configured social provider (settings-based SocialApp —
# no DB row to seed). Leave blank in dev; Google OAuth tests mock allauth's
# adapter layer and never call the real provider.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Email (Mailpit in dev; see infra/compose.dev.yml) -----------------------
# apps/api/config/settings/base.py
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@keel.local

# --- Encryption (apps/api/keel/core/crypto.py) --------------------------------
# Backs Connection.access_token / refresh_token. Dev-only value below —
# generate a real one per environment with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEEL_ENCRYPTION_KEY=O-fOj6lG4KEcdbIbgEHBP8o0lMTG4dH-I_9ICP96te8=

# --- Production-only (apps/api/config/settings/prod.py) ----------------------
# Ignored by dev/test settings. Uncomment and set for a real deployment.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=2592000

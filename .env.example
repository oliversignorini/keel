# Copy to .env and fill in. No secrets or real values are committed here.
# Every variable below is read somewhere in apps/api/config/settings/.

# --- Django core ------------------------------------------------------------
# apps/api/config/settings/base.py
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ----------------------------------------------------------------
# apps/api/config/settings/base.py — parsed by django-environ's env.db().
# Port 5433, not 5432: see infra/compose.dev.yml for why.
DATABASE_URL=postgres://keel:keel@localhost:5433/keel

# --- Redis (cache + Celery broker) -------------------------------------------
# apps/api/config/settings/base.py — parsed by django-environ's env.cache().
REDIS_URL=redis://localhost:6379/0
# Celery broker/result backend. Defaults to REDIS_URL if unset.
CELERY_BROKER_URL=redis://localhost:6379/0

# --- CORS ----------------------------------------------------------------
# apps/api/config/settings/base.py — comma-separated origins Next.js is served from.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Email (Mailpit in dev; see infra/compose.dev.yml) -----------------------
# apps/api/config/settings/base.py
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@keel.local

# --- Encryption (apps/api/keel/core/crypto.py) --------------------------------
# Backs Connection.access_token / refresh_token. Dev-only value below —
# generate a real one per environment with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEEL_ENCRYPTION_KEY=O-fOj6lG4KEcdbIbgEHBP8o0lMTG4dH-I_9ICP96te8=

# --- Production-only (apps/api/config/settings/prod.py) ----------------------
# Ignored by dev/test settings. Uncomment and set for a real deployment.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=2592000

# --- Web (packages/api-client/src/http/mutator.ts) ---------------------------
# Django's origin. Distinct from the app's own origin even in dev (see
# keel-prd.md §4 "Auth architecture" on the api.<domain> subdomain
# requirement) — defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

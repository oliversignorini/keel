# Copy to .env and fill in. No secrets or real values are committed here.
# Every variable below is read somewhere in apps/api/config/settings/.

# --- Django core ------------------------------------------------------------
# apps/api/config/settings/base.py
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=true
# lvh.me (see the "Subdomain routing" block below) plus localhost, since
# manage.py runserver / pytest still get hit directly on localhost. The
# leading-dot form is Django's wildcard-subdomain syntax and covers
# app.lvh.me / api.lvh.me without listing each label.
DJANGO_ALLOWED_HOSTS=lvh.me,.lvh.me,localhost,127.0.0.1

# --- Database ----------------------------------------------------------------
# apps/api/config/settings/base.py — parsed by django-environ's env.db().
# Port 5433, not 5432: see infra/compose.dev.yml for why.
DATABASE_URL=postgres://keel:keel@localhost:5433/keel

# --- Redis (cache + Celery broker) -------------------------------------------
# apps/api/config/settings/base.py — parsed by django-environ's env.cache().
REDIS_URL=redis://localhost:6379/0
# Celery broker/result backend. Defaults to REDIS_URL if unset.
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Subdomain routing (plan 6.A) --------------------------------------------
# The app shell lives on its own subdomain, split from the (marketing) and
# (auth) routes on the apex — see docs/plans/phase-6.md 6.A for the full
# rationale. Dev uses lvh.me, a public DNS name whose wildcard resolves to
# 127.0.0.1 (verified: app.lvh.me -> 127.0.0.1) — NOT app.localhost, because
# browsers special-case "localhost" and handle a `Domain=.localhost` cookie
# attribute inconsistently, which would make the session cookie fail to
# authenticate across app.localhost <-> api.localhost in dev while working
# fine in production. lvh.me is a third-party DNS record, so it does not
# resolve offline; if you need to work without internet access, add these
# lines to your hosts file instead and swap every *.lvh.me below for the
# matching *.keel.test host:
#   127.0.0.1 keel.test app.keel.test api.keel.test
#
#   app.lvh.me:3000    -> Next.js, the (app) route group
#   lvh.me:3000        -> Next.js, the (marketing) route group
#   api.lvh.me:8000    -> Django

# --- Cookies, CORS, CSRF (apps/api/config/settings/base.py) ------------------
# KEEL_APP_DOMAIN: the app's own host (NOT the registrable domain) — see the
# comment above KEEL_APP_DOMAIN in base.py for why it must be the subdomain
# itself so keel.core.checks.check_session_cookie_domain actually exercises
# its subdomain branch.
KEEL_APP_DOMAIN=app.lvh.me
# The registrable domain shared by app.lvh.me, lvh.me and api.lvh.me — must
# be '.' + that domain. apps/api/keel/core/checks.py fails `manage.py check`
# loudly if this is set but is not a parent of KEEL_APP_DOMAIN.
DJANGO_SESSION_COOKIE_DOMAIN=.lvh.me
DJANGO_CSRF_TRUSTED_ORIGINS=http://app.lvh.me:3000,http://lvh.me:3000
# comma-separated origins Next.js is served from.
DJANGO_CORS_ALLOWED_ORIGINS=http://app.lvh.me:3000,http://lvh.me:3000

# --- allauth headless (apps/api/config/settings/base.py) ---------------------
# Next.js origin that HEADLESS_FRONTEND_URLS points verification/reset links
# at — the apex, since (auth) routes are not part of the (app) route group.
KEEL_FRONTEND_URL=http://lvh.me:3000
# The app's own origin (plan 6.A) — used for links generated server-side
# into org-scoped app pages (billing portal returns, trial/dunning emails).
# Defaults to "app." + KEEL_FRONTEND_URL's host if unset.
KEEL_APP_FRONTEND_URL=http://app.lvh.me:3000
# TOTP MFA is installed only when this is true (see keel/core INSTALLED_APPS
# comment) — scaffolded and off by default per PRD §8 Phase 2.
KEEL_MFA_ENABLED=false
# Google is the one configured social provider (settings-based SocialApp —
# no DB row to seed). Leave blank in dev; Google OAuth tests mock allauth's
# adapter layer and never call the real provider.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Email (Mailpit in dev; see infra/compose.dev.yml) -----------------------
# apps/api/config/settings/base.py
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@keel.local

# --- Encryption (apps/api/keel/core/crypto.py) --------------------------------
# Backs Connection.access_token / refresh_token. Dev-only value below —
# generate a real one per environment with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEEL_ENCRYPTION_KEY=O-fOj6lG4KEcdbIbgEHBP8o0lMTG4dH-I_9ICP96te8=

# --- Production-only (apps/api/config/settings/prod.py) ----------------------
# Ignored by dev/test settings. Uncomment and set for a real deployment.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=2592000

# --- Sentry (apps/api/keel/core/sentry.py; apps/web instrumentation
# files) -----------------------------------------------------------------
# Blank in dev/test — both runtimes are documented no-ops without a DSN
# (docs/plans/phase-8.md 8.4). RAILWAY_GIT_COMMIT_SHA is set automatically
# on Railway; GIT_SHA is the fallback for self-host/CI. SENTRY_AUTH_TOKEN
# is only needed to upload source maps at build time — leave it unset and
# the build still succeeds, just without resolved stack frames in Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
GIT_SHA=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- PostHog (apps/api/keel/core/posthog.py; apps/web/lib/posthog) -----------
# Blank in dev/test — both the server-side capture helper and the
# client-side provider are documented no-ops without a key.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Billing (apps/api/config/settings/base.py) ------------------------------
# Both off by default (docs/plans/phase-4.md A.5, B.5). With BILLING_CREDITS
# off there is no credits endpoint at all — GET .../billing/credits/ 404s.
BILLING_CREDITS=false
BILLING_SEAT_PRICING=false

# --- Web (packages/api-client/src/http/mutator.ts) ---------------------------
# Django's origin. Distinct from the app's own origin even in dev (see
# keel-prd.md §4 "Auth architecture" on the api.<domain> subdomain
# requirement) — defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_BASE_URL=http://api.lvh.me:8000

# The dedicated ASGI stream service's origin (PRD §4 system architecture;
# docs/plans/phase-5.5.md 5.5.5) — SSE only, never the sync gunicorn
# process (apps/web/lib/jobs/api.ts). Same hostname via path routing in
# production; a distinct port in dev, run separately with
# `uv run uvicorn config.asgi_stream:application --port 8001` from apps/api.
NEXT_PUBLIC_API_STREAM_URL=http://localhost:8001

# The client-side mirror of BILLING_CREDITS above
# (apps/web/lib/billing/credits-flag.ts). <CreditMeter> renders nothing and
# issues no request unless this is "true"; the server's flag is still the
# authority, and the meter also disappears on the endpoint's 404.
NEXT_PUBLIC_BILLING_CREDITS=false

# --- Marketing / SEO (apps/web/lib/site.ts) ----------------------------------
# The origin the (marketing) route group is served from — used to build
# absolute URLs in sitemap.xml, robots.txt, and JSON-LD. Defaults to
# http://localhost:3000 if unset; every real deployment sets this to the
# project's real domain (e.g. https://acme.com). This is the apex, not the
# app subdomain — marketing and the app shell are on different hosts.
NEXT_PUBLIC_SITE_URL=http://lvh.me:3000

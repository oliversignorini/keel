{
  "name": "keel",
  "private": true,
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "gen": "pnpm -s --filter @keel/cli build && node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "railway": "^3.11.0",
    "turbo": "^2.10.12"
  },
  "pnpm": {
    "overrides": {
      "next": "^15.5.23"
    }
  }
}
